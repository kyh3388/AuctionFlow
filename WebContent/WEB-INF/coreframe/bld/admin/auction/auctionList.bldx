<?xml version="1.0" encoding="UTF-8"?>

<transaction name="adminAuctionList">

	<processor-info type="dbms" datasource="auctionDB">

		<transaction-type>rollback</transaction-type>

		<sql id="adminAuctionList">

			<query>
				SELECT
					A.A_NO,
					A.A_CATEGORY,
					A.A_TITLE,

					A.M_NO AS SELLER_M_NO,
					M.M_ID AS SELLER_M_ID,
					M.M_NAME AS SELLER_M_NAME,

					A.A_START_PRICE,
					A.A_CURRENT_PRICE,
					A.A_BID_COUNT,
					A.A_STATUS,
					A.A_ADMIN_REASON,

					DATE_FORMAT(A.A_END_DATETIME, '%Y-%m-%d %H:%i:%s') AS A_END_DATETIME,
					DATE_FORMAT(A.A_CLOSED_DATETIME, '%Y-%m-%d %H:%i:%s') AS A_CLOSED_DATETIME,
					DATE_FORMAT(A.CREATED_DATETIME, '%Y-%m-%d %H:%i:%s') AS CREATED_DATETIME
				FROM
					KYH_AF_AUCTION A
					
				INNER JOIN
					KYH_AF_MEMBER M
				ON
					M.M_NO = A.M_NO
				ORDER BY
					A.CREATED_DATETIME DESC,
					A.A_NO DESC
			</query>

			<mapping>
				<setProperty></setProperty>

				<getProperty>A_NO,A_CATEGORY,A_TITLE,SELLER_M_NO,SELLER_M_ID,SELLER_M_NAME,A_START_PRICE,A_CURRENT_PRICE,A_BID_COUNT,A_STATUS,A_ADMIN_REASON,A_END_DATETIME,A_CLOSED_DATETIME,CREATED_DATETIME</getProperty>
			</mapping>
		</sql>
	</processor-info>

	<input>
		<block repeat="1">
		</block>
	</input>

	<output>
		<block repeat="1">
			<field name="A_NO" type="long" />
			<field name="A_CATEGORY" type="string" />
			<field name="A_TITLE" type="string" />
			<field name="SELLER_M_NO" type="long" />
			<field name="SELLER_M_ID" type="string" />
			<field name="SELLER_M_NAME" type="string" />
			<field name="A_START_PRICE" type="long" />
			<field name="A_CURRENT_PRICE" type="long" />
			<field name="A_BID_COUNT" type="long" />
			<field name="A_STATUS" type="string" />
			<field name="A_ADMIN_REASON" type="string" />
			<field name="A_END_DATETIME" type="string" />
			<field name="A_CLOSED_DATETIME" type="string" />
			<field name="CREATED_DATETIME" type="string" />
		</block>
	</output>
</transaction>
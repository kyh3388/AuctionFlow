<?xml version="1.0" encoding="UTF-8"?>

<transaction name="auctionPastList">

	<processor-info type="dbms" datasource="auctionDB">

		<transaction-type>rollback</transaction-type>

		<sql id="selectAuctionPastList">

			<query>
				SELECT
					A.A_NO,
					A.A_TITLE,
					A.A_START_PRICE,
					A.A_CURRENT_PRICE,
					A.A_BID_COUNT,
					A.A_STATUS,
					A.HIGHEST_BIDDER_M_NO,
					W.M_ID AS WINNER_M_ID,
					DATE_FORMAT(A.A_END_DATETIME, '%Y-%m-%d %H:%i:%s') AS A_END_DATETIME,
					DATE_FORMAT(A.A_CLOSED_DATETIME, '%Y-%m-%d %H:%i:%s') AS A_CLOSED_DATETIME,
					I.IMG_STORED_NAME

				FROM
					KYH_AF_AUCTION A

				LEFT JOIN
					KYH_AF_MEMBER W
				ON
					W.M_NO = A.HIGHEST_BIDDER_M_NO

				LEFT JOIN (
					SELECT
						A_NO,
						MIN(IMG_STORED_NAME) AS IMG_STORED_NAME
					FROM
						KYH_AF_AUCTION_IMG
					WHERE
						IMG_TYPE = 'MAIN'
					GROUP BY
						A_NO
					) I
				ON
					I.A_NO = A.A_NO
				WHERE
					A.A_STATUS IN ('SOLD', 'UNSOLD', 'CANCELED')
				ORDER BY
					CASE
						WHEN ? = 'LATEST' THEN A.CREATED_DATETIME
					END DESC,

					CASE
						WHEN ? = 'OLDEST' THEN A.CREATED_DATETIME
					END ASC,

					CASE
						WHEN ? = 'PRICE_HIGH' THEN A.A_CURRENT_PRICE
					END DESC,

					CASE
						WHEN ? = 'PRICE_LOW' THEN A.A_CURRENT_PRICE
					END ASC,

					A.A_NO DESC
			</query>

			<mapping>
				<setProperty>
					SORT_LATEST,
					SORT_OLDEST,
					SORT_PRICE_HIGH,
					SORT_PRICE_LOW
				</setProperty>
				<getProperty>
					A_NO,
					A_TITLE,
					A_START_PRICE,
					A_CURRENT_PRICE,
					A_BID_COUNT,
					A_STATUS,
					HIGHEST_BIDDER_M_NO,
					WINNER_M_ID,
					A_END_DATETIME,
					A_CLOSED_DATETIME,
					IMG_STORED_NAME
				</getProperty>
			</mapping>
		</sql>
	</processor-info>

	<input>
		<block repeat="1">
			<field name="SORT_LATEST" type="string" />
			<field name="SORT_OLDEST" type="string" />
			<field name="SORT_PRICE_HIGH" type="string" />
			<field name="SORT_PRICE_LOW" type="string" />
		</block>
	</input>

	<output>
		<block repeat="0">
			<field name="A_NO" type="long" />
			<field name="A_TITLE" type="string" />
			<field name="A_START_PRICE" type="long" />
			<field name="A_CURRENT_PRICE" type="long" />
			<field name="A_BID_COUNT" type="long" />
			<field name="A_STATUS" type="string" />
			<field name="HIGHEST_BIDDER_M_NO" type="long" />
			<field name="WINNER_M_ID" type="string" />
			<field name="A_END_DATETIME" type="string" />
			<field name="A_CLOSED_DATETIME" type="string" />
			<field name="IMG_STORED_NAME" type="string" />
		</block>
	</output>
</transaction>
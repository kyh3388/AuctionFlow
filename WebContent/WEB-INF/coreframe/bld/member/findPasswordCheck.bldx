<?xml version="1.0" encoding="UTF-8"?>

<transaction name="findPasswordCheck">

	<processor-info type="dbms" datasource="auctionDB">
	
		<transaction-type>rollback</transaction-type>
		
		<sql id="findPasswordCheck">
			
			<query>
				SELECT
					COUNT(*) AS MEMBER_COUNT
				FROM
					KYH_AF_MEMBER
				WHERE
					M_ID = ?
				AND
					M_NAME = ?
				AND
					CASE ?
						WHEN 'PHONE' THEN M_PHONE_NUMBER
						WHEN 'EMAIL' THEN M_EMAIL
						ELSE NULL
					END = ?
			</query>
			
			<mapping>
				<setProperty>M_ID,M_NAME,FIND_TYPE,FIND_VALUE</setProperty>
				<getProperty>MEMBER_COUNT</getProperty>
			</mapping>
		</sql>
	</processor-info>
	
	<input>	
		<block repeat="1">
			<field name="M_ID" type="string" />
			<field name="M_NAME" type="string" />
			<field name="FIND_TYPE" type="string" />
			<field name="FIND_VALUE" type="string" />
		</block>
	</input>
	
	<output>
		<block repeat="1">
			<field name="MEMBER_COUNT" type="int" />
		</block>
	</output>
</transaction>
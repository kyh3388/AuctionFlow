<?xml version="1.0" encoding="UTF-8"?>

<transaction name="bidHistory">

	<processor-info type="dbms" datasource="auctionDB">

		<transaction-type>rollback</transaction-type>

		<sql id="selectBidHistory">

			<query>
				SELECT
					A.A_NO,
					A.A_TITLE,
					A.A_CURRENT_PRICE,
					A.A_BID_COUNT,
					A.A_STATUS,
					A.A_ADMIN_REASON,
					MAX(B.BID_PRICE) AS MY_HIGHEST_BID_PRICE,
					COUNT(B.BID_NO) AS MY_BID_COUNT,
					DATE_FORMAT(MAX(B.BID_DATETIME), '%Y-%m-%d %H:%i:%s') AS MY_LAST_BID_DATETIME,
					CASE
						WHEN A.HIGHEST_BIDDER_M_NO = B.M_NO THEN 'Y'
						ELSE 'N'
					END AS IS_HIGHEST_BIDDER,
					I.IMG_STORED_NAME
				FROM
					KYH_AF_AUCTION_BID B
				INNER JOIN
					KYH_AF_AUCTION A
				ON
					A.A_NO = B.A_NO
				LEFT JOIN (
					SELECT
						A_NO,
						MAX(IMG_STORED_NAME) AS IMG_STORED_NAME
					FROM
						KYH_AF_AUCTION_IMG
					WHERE
						IMG_TYPE = 'MAIN'
					GROUP BY
						A_NO
				) I
				ON
					I.A_NO = A.A_NO
				WHERE
					B.M_NO = ?
				GROUP BY
					A.A_NO,
					A.A_TITLE,
					A.A_CURRENT_PRICE,
					A.A_BID_COUNT,
					A.A_STATUS,
					A.A_ADMIN_REASON,
					A.HIGHEST_BIDDER_M_NO,
					B.M_NO,
					I.IMG_STORED_NAME
				ORDER BY
					MAX(B.BID_DATETIME) DESC,
					A.A_NO DESC
			</query>

			<mapping>
				<setProperty>M_NO</setProperty>
				<getProperty>A_NO,A_TITLE,A_CURRENT_PRICE,A_BID_COUNT,A_STATUS,A_ADMIN_REASON,MY_HIGHEST_BID_PRICE,MY_BID_COUNT,MY_LAST_BID_DATETIME,IS_HIGHEST_BIDDER,IMG_STORED_NAME</getProperty>
			</mapping>
		</sql>
	</processor-info>

	<input>
		<block repeat="1">
			<field name="M_NO" type="long" />
		</block>
	</input>

	<output>
		<block repeat="0">
			<field name="A_NO" type="long" />
			<field name="A_TITLE" type="string" />
			<field name="A_CURRENT_PRICE" type="long" />
			<field name="A_BID_COUNT" type="long" />
			<field name="A_STATUS" type="string" />
			<field name="A_ADMIN_REASON" type="string" />
			<field name="MY_HIGHEST_BID_PRICE" type="long" />
			<field name="MY_BID_COUNT" type="long" />
			<field name="MY_LAST_BID_DATETIME" type="string" />
			<field name="IS_HIGHEST_BIDDER" type="string" />
			<field name="IMG_STORED_NAME" type="string" />
		</block>
	</output>
</transaction>
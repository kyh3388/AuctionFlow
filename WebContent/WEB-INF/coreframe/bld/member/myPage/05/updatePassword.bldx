<?xml version="1.0" encoding="UTF-8"?>

<transaction name="updatePassword">

	<processor-info type="dbms" datasource="auctionDB">

		<transaction-type>commit</transaction-type>

		<sql id="updatePassword">

			<query>
				UPDATE
					KYH_AF_MEMBER
				SET
					M_PW = ?,
					UPDATED_DATETIME = NOW()
				WHERE
					M_NO = ?
			</query>

			<mapping>
				<setProperty>M_PW,M_NO</setProperty>
			</mapping>
		</sql>
	</processor-info>

	<input>
		<block repeat="1">
			<field name="M_PW" type="string" />
			<field name="M_NO" type="long" />
		</block>
	</input>

	<output>
		<block repeat="1">
		</block>
	</output>
</transaction>
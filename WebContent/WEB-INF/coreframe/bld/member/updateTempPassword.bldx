<?xml version="1.0" encoding="UTF-8"?>

<transaction name="updateTempPassword">

	<processor-info type="dbms" datasource="auctionDB">
	
		<transaction-type>commit</transaction-type>
		
		<sql id="updateTempPassword">
			
			<query>
				UPDATE
					KYH_AF_MEMBER
				SET
					M_PW = ?,
					UPDATED_DATETIME = NOW()
				WHERE
					M_ID = ?
				AND
					M_NAME = ?
				AND
					CASE ?
						WHEN 'PHONE' THEN M_PHONE_NUMBER
						WHEN 'EMAIL' THEN M_EMAIL
						ELSE NULL
					END = ?
			</query>
			
			<mapping>
				<setProperty>M_PW,M_ID,M_NAME,FIND_TYPE,FIND_VALUE</setProperty>
			</mapping>
		</sql>
	</processor-info>
	
	<input>	
		<block repeat="1">
			<field name="M_PW" type="string" />
			<field name="M_ID" type="string" />
			<field name="M_NAME" type="string" />
			<field name="FIND_TYPE" type="string" />
			<field name="FIND_VALUE" type="string" />
		</block>
	</input>
	
	<output>
		<block repeat="1">
		</block>
	</output>
</transaction>